{
  "name": "freeprompt",
  "version": "1.4.2",
  "description": "Media classifier based on LLM API integration",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "volta": {
    "node": "24.0.0",
    "yarn": "4.18.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "netlify dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "netlify dev --dir=dist",
    "serve:build": "yarn build && yarn serve",
    "test:cache": "node test-cache-issue.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "@types/busboy": "^1.5.5",
    "@types/lambda-tester": "^4.0.3",
    "@types/node": "^24.19.2",
    "@types/sharp": "^0.32.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lambda-tester": "^4.0.1",
    "netlify-cli": "^27.14.2",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@netlify/functions": "^6.0.3",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "busboy": "^1.6.0",
    "chrome-devtools-mcp": "^1.12.0",
    "dotenv": "^18.0.9",
    "ntl": "^5.1.0",
    "sharp": "^0.35.5"
  }
}
